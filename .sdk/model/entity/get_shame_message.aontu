# Entity: get_shame_message

main: kit: entity: get_shame_message: {

  alias: field: {}

  fields: {
    country: {
      h: "Country"
      n: "country"
      r: true
      sh: "The country code for which the shame message was generated"
      t: "`$STRING`"
    }
    detectedFromIp: {
      h: "Detected From Ip"
      n: "detectedFromIp"
      r: false
      sh: "Whether the country was automatically detected from the IP address (true) or explicitly provided via query parameter (false)"
      t: "`$BOOLEAN`"
    }
    ip: {
      h: "Ip"
      n: "ip"
      r: false
      sh: "The IP address of the requester (when available)"
      t: "`$STRING`"
    }
    message: {
      h: "Message"
      n: "message"
      r: true
      sh: "The shame message tailored to the specified or detected country"
      t: "`$STRING`"
    }
  }

  name: "get_shame_message"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "usa"
                k: "query"
                n: "country"
                or: "country"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/"
          q: {
            exist: [
              "country"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
